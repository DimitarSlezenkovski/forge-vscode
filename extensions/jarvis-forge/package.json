{
	"name": "jarvis-forge",
	"displayName": "Jarvis Forge",
	"description": "Jarvis Forge — AI-native engineering inside VS Code. Projects, goals, workflows, approvals and evidence from the local Jarvis daemon.",
	"version": "0.1.0",
	"publisher": "jarvis",
	"engines": {
		"vscode": "^1.90.0"
	},
	"categories": [
		"Other",
		"SCM Providers"
	],
	"activationEvents": [
		"onStartupFinished"
	],
	"main": "./dist/extension.js",
	"capabilities": {
		"untrustedWorkspaces": {
			"supported": "limited",
			"description": "The Lens reads daemon state and shows it. Engaging a directive runs an agent against this folder, and the daemon-launch settings name an executable — so those two settings are never taken from an untrusted workspace.",
			"restrictedConfigurations": [
				"jarvis.daemonLaunch",
				"jarvis.daemonUrl"
			]
		}
	},
	"contributes": {
		"viewsContainers": {
			"secondarySidebar": [
				{
					"id": "jarvis-lens",
					"title": "Jarvis",
					"icon": "media/jarvis.svg"
				}
			],
			"activitybar": [
				{
					"id": "jarvis-forge",
					"title": "Forge",
					"icon": "media/jarvis.svg"
				}
			]
		},
		"views": {
			"jarvis-lens": [
				{
					"type": "webview",
					"id": "jarvis.lens",
					"name": "Lens",
					"icon": "media/jarvis.svg",
					"contextualTitle": "Jarvis Lens",
					"visibility": "visible",
					"initialSize": 3,
					"accessibilityHelpContent": "The Jarvis Lens. Type a directive in the intent field and press Enter to engage it; Shift+Enter captures the goal without running it. Below the field, the flow river lists this workspace's workflows — Enter or Space expands one in place, Escape collapses it. When a workflow needs a decision, a sheet rises with the diff summary, evidence and the Approve, Ask for repair and Deny actions."
				}
			],
			"jarvis-forge": [
				{
					"id": "jarvis.projects",
					"name": "Projects & Goals"
				},
				{
					"id": "jarvis.workflows",
					"name": "Workflows"
				},
				{
					"id": "jarvis.approvals",
					"name": "Approvals"
				}
			]
		},
		"colors": [
			{
				"id": "jarvis.ghostAddedBackground",
				"description": "Tint behind a hunk Jarvis proposes adding to the open file.",
				"defaults": {
					"dark": "#54A8FF29",
					"light": "#0A5FE01F",
					"highContrast": "#00000000",
					"highContrastLight": "#00000000"
				}
			},
			{
				"id": "jarvis.ghostAddedBorder",
				"description": "Leading edge of a proposed addition.",
				"defaults": {
					"dark": "#54A8FF",
					"light": "#0A5FE0",
					"highContrast": "contrastBorder",
					"highContrastLight": "contrastBorder"
				}
			},
			{
				"id": "jarvis.ghostRemovedBackground",
				"description": "Tint behind a hunk Jarvis proposes removing.",
				"defaults": {
					"dark": "#FF8FA029",
					"light": "#C01B361F",
					"highContrast": "#00000000",
					"highContrastLight": "#00000000"
				}
			},
			{
				"id": "jarvis.ghostRemovedBorder",
				"description": "Leading edge of a proposed removal.",
				"defaults": {
					"dark": "#FF8FA0",
					"light": "#C01B36",
					"highContrast": "contrastBorder",
					"highContrastLight": "contrastBorder"
				}
			}
		],
		"keybindings": [
			{
				"command": "jarvis.lens.focus",
				"key": "ctrl+j",
				"mac": "cmd+j"
			}
		],
		"commands": [
			{
				"command": "jarvis.engage",
				"title": "Jarvis: Engage a Directive",
				"icon": "$(rocket)"
			},
			{
				"command": "jarvis.lens.focus",
				"title": "Jarvis: Focus the Lens"
			},
			{
				"command": "jarvis.engagePrompt",
				"title": "Jarvis: Engage a Directive (input box)"
			},
			{
				"command": "jarvis.ghost.accept",
				"title": "Jarvis: Accept Proposed Hunk"
			},
			{
				"command": "jarvis.ghost.reject",
				"title": "Jarvis: Reject Proposed Hunk"
			},
			{
				"command": "jarvis.ghost.why",
				"title": "Jarvis: Why This Change?"
			},
			{
				"command": "jarvis.ghost.clear",
				"title": "Jarvis: Clear Inline Ghost Diffs"
			},
			{
				"command": "jarvis.registerWorkspace",
				"title": "Jarvis: Register This Workspace as a Project",
				"icon": "$(add)"
			},
			{
				"command": "jarvis.runGoal",
				"title": "Jarvis: Run Goal",
				"icon": "$(play)"
			},
			{
				"command": "jarvis.cancelWorkflow",
				"title": "Jarvis: Cancel Workflow",
				"icon": "$(stop-circle)"
			},
			{
				"command": "jarvis.approve",
				"title": "Jarvis: Approve",
				"icon": "$(check)"
			},
			{
				"command": "jarvis.deny",
				"title": "Jarvis: Deny",
				"icon": "$(x)"
			},
			{
				"command": "jarvis.showDiff",
				"title": "Jarvis: Show Workflow Diff",
				"icon": "$(git-compare)"
			},
			{
				"command": "jarvis.showEvidence",
				"title": "Jarvis: Show Evidence"
			},
			{
				"command": "jarvis.refresh",
				"title": "Jarvis: Refresh",
				"icon": "$(refresh)"
			},
			{
				"command": "jarvis.openCommandBridge",
				"title": "Jarvis: Open Command Bridge"
			},
			{
				"command": "jarvis.startDaemon",
				"title": "Jarvis: Start Daemon",
				"icon": "$(debug-start)"
			}
		],
		"menus": {
			"view/title": [
				{
					"command": "jarvis.engage",
					"when": "view == jarvis.workflows",
					"group": "navigation@1"
				},
				{
					"command": "jarvis.refresh",
					"when": "view == jarvis.projects || view == jarvis.workflows || view == jarvis.approvals",
					"group": "navigation@2"
				},
				{
					"command": "jarvis.registerWorkspace",
					"when": "view == jarvis.projects",
					"group": "navigation@1"
				}
			],
			"view/item/context": [
				{
					"command": "jarvis.runGoal",
					"when": "view == jarvis.projects && viewItem == jarvisGoal",
					"group": "inline@1"
				},
				{
					"command": "jarvis.showDiff",
					"when": "view == jarvis.workflows && viewItem =~ /jarvisWorkflow/",
					"group": "inline@1"
				},
				{
					"command": "jarvis.cancelWorkflow",
					"when": "view == jarvis.workflows && viewItem == jarvisWorkflowActive",
					"group": "inline@2"
				},
				{
					"command": "jarvis.showEvidence",
					"when": "view == jarvis.workflows && viewItem =~ /jarvisWorkflow/",
					"group": "1_jarvis@1"
				},
				{
					"command": "jarvis.approve",
					"when": "view == jarvis.approvals && viewItem == jarvisApproval",
					"group": "inline@1"
				},
				{
					"command": "jarvis.showDiff",
					"when": "view == jarvis.approvals && viewItem == jarvisApproval",
					"group": "inline@2"
				},
				{
					"command": "jarvis.deny",
					"when": "view == jarvis.approvals && viewItem == jarvisApproval",
					"group": "inline@3"
				}
			]
		},
		"configuration": {
			"title": "Jarvis Forge",
			"properties": {
				"jarvis.daemonUrl": {
					"type": "string",
					"default": "http://localhost:5178",
					"description": "Base URL of the local Jarvis daemon (jarvisd)."
				},
				"jarvis.commandBridgeUrl": {
					"type": "string",
					"default": "http://localhost:1420",
					"description": "URL of the Nexus Command Bridge dev server (for the Open Command Bridge command)."
				},
				"jarvis.daemonLaunch": {
					"type": [
						"object",
						"null"
					],
					"default": null,
					"markdownDescription": "How **Jarvis: Start Daemon** launches jarvisd. Leave empty to auto-detect: a workspace folder containing `src/Jarvis.Host/Jarvis.Host.csproj` runs `dotnet run --project <that>`, otherwise `jarvisd` is tried on PATH. Arguments are passed as an argv vector to a visible integrated terminal — never through a shell.",
					"properties": {
						"command": {
							"type": "string",
							"description": "Executable: a bare name resolved on PATH (e.g. dotnet, jarvisd) or an absolute path. No spaces or shell metacharacters."
						},
						"args": {
							"type": "array",
							"items": {
								"type": "string"
							},
							"default": [],
							"description": "Argument vector, one element per argument."
						},
						"cwd": {
							"type": "string",
							"description": "Working directory for the daemon terminal."
						}
					},
					"required": [
						"command"
					],
					"additionalProperties": false
				}
			}
		}
	}
}
