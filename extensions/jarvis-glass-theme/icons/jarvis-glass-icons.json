{
	"$comment": "Jarvis Glass file icons. Fourteen hand-drawn 16x16 glyphs on one geometric grid (1.2px strokes, round joins), mapped by language id first and by extension/filename only where no language covers the case. Seti's per-language colour explosion fights a translucent workbench: on glass, saturated icons read as noise and the eye loses the file names. This set keeps one slate silhouette and spends colour only on the file's KIND - code, data, prose, media, shell, secret. No dependencies, no icon font, no third-party assets.",
	"hidesExplorerArrows": false,
	"iconDefinitions": {
		"_file": { "iconPath": "./file.svg" },
		"_code": { "iconPath": "./code.svg" },
		"_data": { "iconPath": "./data.svg" },
		"_doc": { "iconPath": "./doc.svg" },
		"_style": { "iconPath": "./style.svg" },
		"_markup": { "iconPath": "./markup.svg" },
		"_image": { "iconPath": "./image.svg" },
		"_shell": { "iconPath": "./shell.svg" },
		"_lock": { "iconPath": "./lock.svg" },
		"_git": { "iconPath": "./git.svg" },
		"_settings": { "iconPath": "./settings.svg" },
		"_folder": { "iconPath": "./folder.svg" },
		"_folderOpen": { "iconPath": "./folder-open.svg" },
		"_folderRoot": { "iconPath": "./folder-root.svg" }
	},

	"file": "_file",
	"folder": "_folder",
	"folderExpanded": "_folderOpen",
	"rootFolder": "_folderRoot",
	"rootFolderExpanded": "_folderRoot",

